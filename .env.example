# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Credentials (optional for live Supabase sync; built-in persistent DB is used by default)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# LiveKit Credentials (for cloud WebRTC; fallback local signing active by default)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"

# Compliance & Legal Gateway (Strictly DEMO mode enforced)
DEPLOYMENT_MODE="DEMO_NON_WAGERING"
LEGAL_AUTHORIZATION_VERIFIED="false"

